# Copy this file to .env and replace the placeholder before a live model run.
# Switch providers by changing both OCA_MODEL_PROVIDER and OCA_MODEL.
# Install the matching langchain-<provider> package for providers beyond those bundled.
OCA_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
OCA_MODEL=claude-sonnet-5
OCA_MAX_OUTPUT_TOKENS=8192
