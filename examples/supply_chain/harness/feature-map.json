{
  "features": [
    {
      "name": "material issue and production consumption",
      "domain": "manufacturing",
      "repositories": ["northstar/inventory-ledger", "northstar/warehouse-execution", "northstar/manufacturing-execution"],
      "ground_truth": ["prds/warehouse-material-issue.md", "prds/work-order-start.md", "decisions/adr-014-material-issue-idempotency.md"],
      "path_globs": {
        "northstar/inventory-ledger": ["src/inventory/material_issue*.py"],
        "northstar/warehouse-execution": ["src/warehouse/material_issue*.py"],
        "northstar/manufacturing-execution": ["src/manufacturing/work_order_start*.py"]
      },
      "components": [
        {"repository": "northstar/inventory-ledger", "role": "event consumer and stock writer", "path_globs": ["src/inventory/material_issue*.py"], "tests": ["tests/test_material_issue_idempotency.py"]},
        {"repository": "northstar/warehouse-execution", "role": "event producer and retry outbox", "path_globs": ["src/warehouse/material_issue*.py"], "tests": ["tests/test_pick_confirmation.py"]},
        {"repository": "northstar/manufacturing-execution", "role": "downstream work-order guard", "path_globs": ["src/manufacturing/work_order_start*.py"], "tests": ["tests/test_work_order_start.py"]}
      ],
      "owners": ["Inventory Platform", "Warehouse Execution", "Manufacturing Systems"],
      "consumers": ["Available-to-promise API", "Warehouse pick confirmation", "MES work-order start"],
      "tests": ["tests/test_material_issue_idempotency.py", "tests/test_pick_confirmation.py", "tests/test_work_order_start.py"]
    },
    {
      "name": "available to promise",
      "domain": "inventory",
      "repositories": ["northstar/inventory-ledger", "northstar/inventory-api"],
      "ground_truth": ["prds/inventory-availability.md"],
      "path_globs": {
        "northstar/inventory-ledger": ["src/inventory/availability*.py"],
        "northstar/inventory-api": ["src/api/availability*.py"]
      },
      "owners": ["Inventory Platform"],
      "consumers": ["Sales allocation", "MES work-order start"],
      "tests": ["tests/test_available_to_promise.py"]
    },
    {
      "name": "lot traceability",
      "domain": "warehouse",
      "repositories": ["northstar/warehouse-execution", "northstar/manufacturing-execution"],
      "ground_truth": ["prds/warehouse-material-issue.md", "prds/work-order-start.md"],
      "path_globs": {
        "northstar/warehouse-execution": ["src/warehouse/lot_trace*.py"],
        "northstar/manufacturing-execution": ["src/manufacturing/lot_trace*.py"]
      },
      "owners": ["Warehouse Execution", "Manufacturing Systems"],
      "consumers": ["Recall reporting", "Quality hold checks"],
      "tests": ["tests/test_lot_traceability.py"]
    },
    {
      "name": "operator material issue workflow",
      "domain": "warehouse",
      "repositories": ["northstar/scanner-ui", "northstar/warehouse-api", "northstar/warehouse-execution", "northstar/inventory-ledger", "northstar/inventory-api", "northstar/mes-ui"],
      "ground_truth": ["prds/warehouse-material-issue.md", "prds/work-order-start.md"],
      "components": [
        {"repository": "northstar/scanner-ui", "role": "lot scan and offline retry", "path_globs": ["src/scanner/material-issue/**"], "tests": ["tests/material-issue.spec.ts"]},
        {"repository": "northstar/warehouse-api", "role": "pick confirmation API", "path_globs": ["src/api/pick-confirmation/**"], "tests": ["tests/test_pick_confirmation_api.py"]},
        {"repository": "northstar/warehouse-execution", "role": "issue event publisher", "path_globs": ["src/warehouse/material_issue*.py"], "tests": ["tests/test_pick_confirmation.py"]},
        {"repository": "northstar/inventory-ledger", "role": "idempotent event consumer and stock writer", "path_globs": ["src/inventory/material_issue*.py"], "tests": ["tests/test_material_issue_idempotency.py"]},
        {"repository": "northstar/inventory-api", "role": "updated availability response", "path_globs": ["src/api/availability*.py"], "tests": ["tests/test_available_to_promise.py"]},
        {"repository": "northstar/mes-ui", "role": "work-order readiness display", "path_globs": ["src/work-orders/readiness/**"], "tests": ["tests/work-order-readiness.spec.ts"]}
      ],
      "product_flows": [{
        "id": "handheld-material-issue",
        "name": "Confirm a material issue from an assigned pick",
        "persona": "Warehouse operator",
        "entrypoint": {"screen": "Assigned picks", "route": "/picks/assigned", "frontend_repository": "northstar/scanner-ui"},
        "steps": [
          {"action": "Open an assigned pick and scan its lot", "screen": "Pick confirmation", "route": "/picks/{pick_id}/confirm", "frontend_repository": "northstar/scanner-ui", "api_calls": [{"method": "GET", "path": "/api/picks/{pick_id}", "backend_repository": "northstar/warehouse-api", "code_symbol": "get_pick"}]},
          {"action": "Confirm the issued quantity", "screen": "Issue confirmation", "frontend_repository": "northstar/scanner-ui", "api_calls": [{"method": "POST", "path": "/api/picks/{pick_id}/material-issue", "backend_repository": "northstar/warehouse-api", "code_symbol": "confirm_material_issue"}]},
          {"action": "Check updated material readiness", "screen": "Work-order readiness", "route": "/work-orders/{work_order_id}", "frontend_repository": "northstar/mes-ui", "api_calls": [{"method": "GET", "path": "/api/availability", "backend_repository": "northstar/inventory-api", "code_symbol": "available_quantity"}]}
        ],
        "events": [{"name": "MaterialIssued", "producer_repository": "northstar/warehouse-execution", "consumer_repositories": ["northstar/inventory-ledger"], "code_symbols": ["event_id", "material_issue_consumer"]}],
        "success_state": "The issue is applied once and updated availability is visible to MES before work-order start."
      }],
      "owners": ["Warehouse Execution", "Inventory Platform", "Manufacturing Systems"],
      "consumers": ["Handheld operators", "Warehouse supervisors", "Shop-floor operators"],
      "tests": ["tests/e2e/material-issue-workflow.spec.ts"]
    }
  ]
}
